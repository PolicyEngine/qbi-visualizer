{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/.next",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/us/qbi-calculator/api/:path*",
      "destination": "https://policyengine--qbi-visualizer-backend-web.modal.run/api/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/us/qbi-calculator",
      "permanent": false
    }
  ]
}
